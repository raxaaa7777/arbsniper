{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArbSniper",
  "version": "0.1.0",
  "identifier": "app.arbsniper.p2p",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ArbSniper",
        "width": 720,
        "height": 760,
        "minWidth": 600,
        "minHeight": 620,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://p2p.binance.com https://api2.bybit.com https://www.okx.com https://api.coingecko.com https://api.binance.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
